# ============================================================
# .env.example — Variables globales del proyecto UCGI
# Copia este archivo a .env y ajusta los valores.
# El archivo .env real está gitignored.
# ============================================================

# ===== MariaDB =====
MARIADB_ROOT_PASSWORD=changeme-root
MARIADB_USER=ucgi_app
MARIADB_PASSWORD=changeme-app
MARIADB_DATABASE=crm

# ===== midPoint =====
# midPoint usa PostgreSQL dedicado (servicio midpoint-db en compose).
# MariaDB se mantiene para los datos del CRM. Las dos DBs viven en la misma
# red ucgi-net.
MP_DB_USER=midpoint
MP_DB_PASSWORD=changeme-mp
MP_ADMIN_PASSWORD=5ecr3t

# ===== integration-api (Spring Boot) =====
SPRING_DATASOURCE_URL=jdbc:mariadb://db:3306/crm
SPRING_DATASOURCE_USERNAME=ucgi_app
SPRING_DATASOURCE_PASSWORD=changeme-app
JWT_SECRET=changeme-min-32-chars-required-here-please
JWT_EXPIRATION_MINUTES=60
MIDPOINT_BASE_URL=http://midpoint:8080/midpoint
MIDPOINT_ADMIN_USER=administrator
MIDPOINT_ADMIN_PASSWORD=5ecr3t

# ===== Asterisk (AMI desde el API) =====
ASTERISK_AMI_HOST=asterisk
ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USER=ucgi-ami
ASTERISK_AMI_SECRET=changeme-ami
ASTERISK_CONFIG_PATH=/etc/asterisk/pjsip.conf

# ===== CRM (Vite, build-time) =====
VITE_API_BASE_URL=/api
VITE_SIP_WS_URL=wss://localhost:8089/ws
VITE_SIP_DOMAIN=localhost

# ===== SonarQube =====
SONAR_HOST_URL=http://sonar:9000
SONAR_TOKEN=changeme

# ===== Grafana =====
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=changeme

# ===== Despliegue =====
COMPOSE_PROJECT_NAME=ucgi
TZ=America/Lima
