# ============================================================
# .env.example — Variables globales del proyecto UCGI
# Copia este archivo a .env y ajusta los valores.
# El archivo .env real está gitignored.
# ============================================================

# ===== MariaDB =====
MARIADB_ROOT_PASSWORD=changeme-root
MARIADB_USER=ucgi_app
MARIADB_PASSWORD=changeme-app
MARIADB_DATABASE=crm

# ===== midPoint =====
# midPoint usa PostgreSQL dedicado (servicio midpoint-db en compose).
# MariaDB se mantiene para los datos del CRM. Las dos DBs viven en la misma
# red ucgi-net.
MP_DB_USER=midpoint
MP_DB_PASSWORD=changeme-mp
MP_ADMIN_PASSWORD=5ecr3t

# ===== integration-api (Spring Boot) =====
SPRING_DATASOURCE_URL=jdbc:mariadb://db:3306/crm
SPRING_DATASOURCE_USERNAME=ucgi_app
SPRING_DATASOURCE_PASSWORD=changeme-app
JWT_SECRET=changeme-min-32-chars-required-here-please
JWT_EXPIRATION_MINUTES=60
MIDPOINT_BASE_URL=http://midpoint:8080/midpoint
MIDPOINT_ADMIN_USER=administrator
MIDPOINT_ADMIN_PASSWORD=5ecr3t

# ===== MikoPBX (REST API consumida por integration-api desde HU-03.8) =====
# La GUI es accesible en http://localhost:8090 (admin/admin por defecto;
# cambiar tras el primer login). REST API en /pbxcore/api/.
MIKOPBX_HOST=mikopbx
MIKOPBX_PORT=80
MIKOPBX_ADMIN_USER=admin
MIKOPBX_ADMIN_PASSWORD=admin

# ===== Asterisk legado (HU-03.4 fase 1, sin uso desde 2026-06-19) =====
# Estas vars siguen en el contrato porque integration-api aún tiene el
# AsteriskAmiClient como código no eliminado (queda por evidencia HU-03.4).
# Apuntan a mikopbx que también expone AMI 5038 internamente.
ASTERISK_AMI_HOST=mikopbx
ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USER=ucgi-ami
ASTERISK_AMI_SECRET=changeme-ami
ASTERISK_CONFIG_PATH=/etc/asterisk/pjsip.conf

# ===== CRM (Vite, build-time) =====
VITE_API_BASE_URL=/api
VITE_SIP_WS_URL=wss://localhost:8089/asterisk/ws
VITE_SIP_DOMAIN=localhost

# ===== SonarQube =====
SONAR_HOST_URL=http://sonar:9000
SONAR_TOKEN=changeme

# ===== Grafana =====
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=changeme

# ===== ucgi-shaper (HU-08.5 versión mínima + HU-03.7) =====
# El stub Flask reporta este BW por defecto. Cambiar para demo:
#   curl -X POST http://localhost:9100/admin/bandwidth -H 'Content-Type: application/json' -d '{"mbps":8}'
SHAPER_MOCK_BANDWIDTH_MBPS=50
SHAPER_MOCK_QDISC_ACTIVE=false

# integration-api consume el shaper via esta URL.
SHAPER_BASE_URL=http://shaper:9100

# ===== Despliegue =====
COMPOSE_PROJECT_NAME=ucgi
TZ=America/Lima
