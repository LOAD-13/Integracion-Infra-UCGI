{
  "schemaVersion": 39,
  "version": 1,
  "uid": "ucgi-overview",
  "title": "UCGI Overview",
  "tags": ["ucgi", "voip"],
  "timezone": "browser",
  "refresh": "15s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Integration API",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "ucgi-prom" },
      "targets": [{
        "expr": "up{job=\"integration-api\"}",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null },
            { "color": "green", "value": 1 }
          ] }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Shaper",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "ucgi-prom" },
      "targets": [{ "expr": "up{job=\"shaper\"}", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null },
            { "color": "green", "value": 1 }
          ] }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Tier de códec",
      "description": "3=FULL (opus+vp8) · 2=MIXED (opus audio) · 1=DOWNGRADED (g729) · 0=EMERGENCY",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "ucgi-prom" },
      "targets": [{ "expr": "ucgi_shaper_tier", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": {
              "0": { "text": "EMERGENCY", "color": "red" },
              "1": { "text": "DOWNGRADED", "color": "orange" },
              "2": { "text": "MIXED", "color": "yellow" },
              "3": { "text": "FULL", "color": "green" }
            } }
          ],
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null },
            { "color": "orange", "value": 1 },
            { "color": "yellow", "value": 2 },
            { "color": "green", "value": 3 }
          ] }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Ancho de banda (Mbps)",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "ucgi-prom" },
      "targets": [{ "expr": "ucgi_shaper_bandwidth_mbps", "refId": "A" }],
      "fieldConfig": {
        "defaults": { "unit": "Mbits", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [
          { "color": "red", "value": null },
          { "color": "orange", "value": 5 },
          { "color": "green", "value": 30 }
        ] } }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Llamadas activas",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "ucgi-prom" },
      "targets": [{ "expr": "ucgi_shaper_active_calls", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "short" } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "JVM heap usado",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "ucgi-prom" },
      "targets": [{
        "expr": "sum(jvm_memory_used_bytes{job=\"integration-api\",area=\"heap\"}) / 1024 / 1024",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "decmbytes" } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "HTTP requests/sec (integration-api)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "ucgi-prom" },
      "targets": [{
        "expr": "sum by (uri) (rate(http_server_requests_seconds_count{job=\"integration-api\"}[1m]))",
        "legendFormat": "{{uri}}",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Latency p95 (integration-api)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "ucgi-prom" },
      "targets": [{
        "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{job=\"integration-api\"}[5m])))",
        "legendFormat": "p95 {{uri}}",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Shaper · BW Mbps vs tier",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "ucgi-prom" },
      "targets": [
        { "expr": "ucgi_shaper_bandwidth_mbps", "legendFormat": "BW Mbps", "refId": "A" },
        { "expr": "ucgi_shaper_tier", "legendFormat": "tier", "refId": "B" }
      ]
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Required kbps (próxima llamada)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "ucgi-prom" },
      "targets": [{ "expr": "ucgi_shaper_required_kbps", "legendFormat": "kbps", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "Kbits" } }
    }
  ]
}
