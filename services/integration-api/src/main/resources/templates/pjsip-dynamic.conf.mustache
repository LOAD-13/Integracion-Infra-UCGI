;
; pjsip-dynamic.conf — generado por integration-api (UCGI)
; NO editar a mano. Cualquier cambio se sobrescribe al regenerar.
; Total extensiones activas: {{extensionCount}}
; Incluido desde /etc/asterisk/pjsip.conf vía #tryinclude.
;
{{#extensions}}
; ---------- Extension {{number}} ----------
[{{number}}]
type=endpoint
context=internal
disallow=all
allow=opus,ulaw,alaw,gsm,g729
auth={{number}}
aors={{number}}
transport=transport-udp
webrtc=yes

[{{number}}]
type=auth
auth_type=userpass
username={{number}}
password={{password}}

[{{number}}]
type=aor
max_contacts=1
remove_existing=yes

{{/extensions}}
